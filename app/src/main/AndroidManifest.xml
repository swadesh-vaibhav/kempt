<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- See which app is in the foreground. User must grant "Usage access" in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Draw the block / lock overlay on top of other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Persistent monitor. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Status + partner notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-arm active blocks after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ask to be exempt from battery optimisation (OEM background killers). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Enumerate installed apps for the blocklist picker.
         Restricted permission — you must declare its use in the Play Console. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KemptApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kempt"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kempt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen passcode lock for apps the overlay can't cover (e.g. Settings).
             Its own task, kept out of Recents, single-instance so re-launches don't stack. -->
        <activity
            android:name=".monitor.LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Kempt" />

        <!-- Foreground service that watches the current app. -->
        <service
            android:name=".monitor.AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_usage_monitoring_for_self_control" />
        </service>

        <!-- Uninstall protection: registering as a device administrator makes Android refuse
             Kempt's uninstall while the admin is active. Friction, not a wall — the deactivation
             it forces is reported to the partner (see KemptDeviceAdminReceiver).
             The policy set (@xml/device_admin) is empty, so this admin can ONLY block its own
             uninstall — no wipe, lock, or password powers.
             exported="true" is required because the OS (a different process) delivers the admin
             broadcasts; BIND_DEVICE_ADMIN restricts those broadcasts to the system alone. -->
        <receiver
            android:name=".monitor.KemptDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/uninstall_protection_explanation"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Re-arm active blocks after a reboot. -->
        <receiver
            android:name=".monitor.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FCM: partner unlock messages / alerts.
             Needs the google-services plugin + google-services.json to work at runtime. -->
        <service
            android:name=".sync.KemptMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
